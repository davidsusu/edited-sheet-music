% MIDI-only lowering.  Collect first, then resolve in musical time: syntax
% traversal order is not time order for simultaneous named-Voice continuations.
#(define (rectify:trill-notes music)
   (filter (lambda (e) (eq? (ly:music-property e 'name) 'NoteEvent))
           (ly:music-property music 'elements)))

#(define (rectify:trill-event? event)
   (eq? (ly:music-property event 'name) 'TrillSpanEvent))

#(define (rectify:trill-articulation music)
   (find (lambda (e) (ly:music-property e 'trill-resolved #f))
         (ly:music-property music 'elements)))

#(define (rectify:after-grace-branch? music)
   (and (eq? (ly:music-property music 'name) 'SequentialMusic)
        (equal? (map (lambda (e) (ly:music-property e 'name))
                     (ly:music-property music 'elements))
                '(SkipMusic GraceMusic))))

#(define (rectify:trill-warning music reason)
   (let ((notes (rectify:trill-notes music)))
     (ly:music-warning (if (pair? notes) (car notes) music)
                       (string-append "MIDI trill skipped: " reason))))

#(define (rectify:trill-upper pitch key alteration)
   (let* ((step (1+ (ly:pitch-notename pitch)))
          (name (modulo step 7))
          (octave (+ (ly:pitch-octave pitch) (quotient step 7)))
          (entry (or (assoc (cons octave name) key) (assv name key))))
     (ly:make-pitch octave name
                    (if (number? alteration) alteration
                        (if entry (cdr entry) 0)))))

% Visit in syntax order, but report musical time and actual Voice identity.
% Bottom wrappers (notably \after) add simultaneous events to the SAME Voice.
#(define (rectify:walk-voices music visit)
   (define (walk m time path staff voice grace region)
     (visit m time staff voice grace region)
     (let ((name (ly:music-property m 'name))
           (element (ly:music-property m 'element))
           (elements (ly:music-property m 'elements)))
       (case name
        ((ContextSpeccedMusic)
         (let* ((type (ly:music-property m 'context-type))
                (id (ly:music-property m 'context-id))
                (named (and (string? id) (not (string-null? id))))
                (part (list type (if named id (gensym "context"))))
                (new-path (append path (list part))))
           (cond
            ((and (eq? type 'Bottom)
                  (eq? (ly:music-property element 'name) 'SimultaneousMusic))
             (for-each (lambda (branch)
                         (walk branch time path staff voice grace (gensym "parallel")))
                       (ly:music-property element 'elements)))
            ((and (not named) (not (ly:music-property m 'create-new #f)))
             (walk element time path staff voice grace region))
            ((eq? type 'Voice)
             (walk element time path staff (append staff (list part)) grace region))
            ((memq type '(Staff RhythmicStaff))
             (walk element time new-path new-path (append new-path '(implicit)) grace region))
            (else (walk element time new-path staff voice grace region)))))
        ((SequentialMusic)
         (let loop ((es elements) (now time))
           (if (pair? es)
               (begin
                 (walk (car es) now path staff voice grace region)
                 (loop (cdr es)
                       (if grace now
                           (+ now (ly:moment-main (ly:music-length (car es))))))))))
        ((SimultaneousMusic)
         (for-each
          (lambda (branch index)
            (walk branch time path staff
                  (if (or (= index 0) (rectify:after-grace-branch? branch)) voice
                      (append voice (list (gensym "branch")))) grace
                  (gensym "parallel")))
          elements (iota (length elements))))
        ((GraceMusic) (walk element time path staff voice #t region))
        ((EventChord) #t)
        (else
         (if (ly:music? element) (walk element time path staff voice grace region))
         (for-each (lambda (e) (walk e time path staff voice grace region)) elements)))))
   (walk music 0 '() '() '(implicit) #f 'root))

#(define (rectify:remove-ties! music)
   (music-map
    (lambda (item)
      (for-each
       (lambda (property)
         (set! (ly:music-property item property)
               (filter (lambda (e) (not (eq? (ly:music-property e 'name) 'TieEvent)))
                       (ly:music-property item property))))
       '(elements articulations))
      item)
    music))

% A control event can fall inside a sustained note (\after ... \stopTrillSpan).
% Split only its MIDI copy at that time; attach onset events only once.
#(define (rectify:trill-split-chord chord lengths)
   (let ((notes (rectify:trill-notes chord)))
     (let loop ((remaining lengths) (first #t) (out '()))
       (if (null? remaining)
           (reverse out)
           (let* ((last (null? (cdr remaining)))
                  (part (ly:music-deep-copy chord)))
             (if (not first)
                 (set! (ly:music-property part 'elements)
                       (map ly:music-deep-copy
                            (append notes
                                    (filter (lambda (event)
                                              (memq (ly:music-property event 'articulation-type)
                                                    '(trill tenuto)))
                                            (ly:music-property chord 'elements))))))
             (rectify:remove-ties! part)
             (for-each
              (lambda (note)
                (set! (ly:music-property note 'duration)
                      (make-duration-of-length (ly:make-moment (car remaining)))))
              (rectify:trill-notes part))
             (if (or (not last) (rectify:contains-event? chord 'TieEvent))
                 (set! (ly:music-property part 'elements)
                       (append (ly:music-property part 'elements)
                               (list (make-music 'TieEvent)))))
             (loop (cdr remaining) #f (cons part out)))))))

% Only merge adjacent, plain continuations.  In particular do not move a
% dynamic/tempo boundary or restructure the simultaneous afterGrace idiom.
#(define (rectify:trill-merge-ties music)
   (if (eq? (ly:music-property music 'name) 'SequentialMusic)
       (let loop ((remaining (ly:music-property music 'elements)) (out '()))
         (if (null? remaining)
             (set! (ly:music-property music 'elements) (reverse out))
             (let* ((next (car remaining))
                    (previous (and (pair? out) (car out)))
                    (notes (rectify:trill-notes next))
                    (prior (if previous (rectify:trill-notes previous) '())))
               (if (and (= (length notes) 1) (= (length prior) 1)
                        (rectify:contains-event? previous 'TieEvent)
                        (rectify:trill-articulation previous)
                        (rectify:trill-articulation next)
                        (not (ly:music-property next 'trill-boundary #f))
                        (equal? (ly:music-property (rectify:trill-articulation previous) 'pitch)
                                (ly:music-property (rectify:trill-articulation next) 'pitch))
                        (equal? (ly:music-property (rectify:trill-articulation previous) 'twiddle)
                                (ly:music-property (rectify:trill-articulation next) 'twiddle))
                        (equal? (ly:music-property (car notes) 'pitch)
                                (ly:music-property (car prior) 'pitch))
                        (every (lambda (e)
                                 (or (memq (ly:music-property e 'name)
                                           '(NoteEvent TieEvent))
                                     (eq? (ly:music-property e 'articulation-type) 'trill)))
                               (ly:music-property next 'elements))
                        (null? (ly:music-property (car notes) 'articulations)))
                   (begin
                     (set! (ly:music-property (car prior) 'duration)
                           (make-duration-of-length
                            (ly:moment-add (ly:music-length previous)
                                           (ly:music-length next))))
                     (set! (ly:music-property previous 'elements)
                           (append
                            (filter (lambda (e)
                                      (not (eq? (ly:music-property e 'name)
                                                'TieEvent)))
                                    (ly:music-property previous 'elements))
                            (filter (lambda (e)
                                      (eq? (ly:music-property e 'name) 'TieEvent))
                                    (ly:music-property next 'elements))))
                     (loop (cdr remaining) out))
                   (loop (cdr remaining) (cons next out)))))))
   music)

#(define* (rectify:trill-spans music #:optional (performance-tempos '()))
   (let ((records '()) (serial 0) (staff-paths '())
         (keys '()) (states '()) (pending-ties '()) (tempo 15))
     (define (put! table key value)
       (acons key value (assoc-remove! table key)))
     (define (emit time staff voice event grace)
       (set! serial (1+ serial))
       (set! records (cons (vector time serial staff voice event grace) records)))
     (define (collect m time staff voice grace region)
       (if (and (pair? staff) (not (member staff (map cdr staff-paths))))
           (set! staff-paths (acons (cadar (reverse staff)) staff staff-paths)))
       (case (ly:music-property m 'name)
        ((EventChord KeyChangeEvent ContextChange) (emit time staff voice m grace))
        ((PropertySet)
         (if (eq? (ly:music-property m 'symbol) 'tempoWholesPerMinute)
             (emit time staff voice m grace)))))
     (define (split-at-controls!)
       (let ((boundaries '()) (replacements '()) (original records))
         (for-each
          (lambda (record)
            (if (and (not (vector-ref record 5))
                     (any rectify:trill-event?
                          (ly:music-property (vector-ref record 4) 'elements)))
                (let* ((voice (vector-ref record 3))
                       (entry (assoc voice boundaries)))
                  (set! boundaries
                        (put! boundaries voice
                              (cons (vector-ref record 0) (if entry (cdr entry) '())))))))
          original)
         (set! records '())
         (for-each
          (lambda (record)
            (let* ((m (vector-ref record 4))
                   (start (vector-ref record 0))
                   (end (+ start (ly:moment-main (ly:music-length m))))
                   (entry (assoc (vector-ref record 3) boundaries))
                   (standalone (any (lambda (event)
                                      (eq? (ly:music-property event 'articulation-type) 'trill))
                                    (ly:music-property m 'elements)))
                   (cuts (if (and (or entry standalone) (not (vector-ref record 5))
                                  (= (length (rectify:trill-notes m)) 1))
                             (sort (delete-duplicates
                                    (filter (lambda (t) (< start t end))
                                            (append (if entry (cdr entry) '())
                                                    (map car performance-tempos)))) <)
                             '())))
              (if (null? cuts)
                  (set! records (cons record records))
                  (let* ((times (cons start cuts))
                         (parts (rectify:trill-split-chord
                                 m (map - (append cuts (list end)) times))))
                    (set! replacements (acons m (make-sequential-music parts) replacements))
                    (for-each
                     (lambda (time part)
                       (emit time (vector-ref record 2) (vector-ref record 3) part #f))
                     times parts)))))
          (reverse original))
         (set! music (music-map
                      (lambda (m) (let ((entry (assq m replacements)))
                                    (if entry (cdr entry) m))) music))))
     (define (key-at staff)
       (let ((entry (assoc staff keys)))
         (if entry (cdr entry)
             (if (null? staff) '() (key-at (drop-right staff 1))))))
     (define (state-for voice staff)
       (let ((entry (assoc voice states)))
         (if entry (cdr entry)
             (let ((state (vector staff #f #f #f)))
               ;; staff, active start event, initial main pitch, initial auxiliary
               (set! states (acons voice state states))
               state))))
     (define (mark-unsafe-ties record)
       (let* ((voice (vector-ref record 3))
              (m (vector-ref record 4))
              (notes (rectify:trill-notes m))
              (pending (assoc voice pending-ties)))
         (if (and (pair? notes) (not (vector-ref record 5)))
             (begin
               (if pending
                   (let* ((previous (cdr pending))
                          (prior (rectify:trill-notes previous)))
                     ;; Across wrappers, retain the rhythmic structure and
                     ;; articulate each segment instead of silencing the trill.
                     (if (and (= (length prior) 1) (= (length notes) 1)
                              (or (rectify:trill-articulation previous)
                                  (rectify:trill-articulation m))
                              (equal? (ly:music-property (car prior) 'pitch)
                                      (ly:music-property (car notes) 'pitch)))
                         (begin
                           (rectify:remove-ties! previous)
                           ;; The final main-note attack can sustain into the
                           ;; plain note after the span, never cancel the trill.
                           (if (and (rectify:trill-articulation previous)
                                    (not (rectify:trill-articulation m)))
                               (set! (ly:music-property previous 'trill-terminal-tie) #t)))
                         (begin (suppress-trill previous) (suppress-trill m)))
                     (set! pending-ties (assoc-remove! pending-ties voice))))
               (if (rectify:contains-event? m 'TieEvent)
                   (set! pending-ties (put! pending-ties voice m)))))))
     (define (suppress-trill m)
       (if (rectify:trill-articulation m)
           (begin
             (rectify:trill-warning m "unsafe tie boundary; retaining the written tie")
             (set! (ly:music-property m 'trill-twiddle)
                   (ly:music-property (rectify:trill-articulation m) 'twiddle))
             (set! (ly:music-property m 'elements)
                   (filter (lambda (e)
                             (not (ly:music-property e 'trill-resolved #f)))
                           (ly:music-property m 'elements))))))
     (define (resolve record)
       (let* ((staff (vector-ref record 2))
              (voice (vector-ref record 3))
              (m (vector-ref record 4))
              (state (state-for voice staff))
              (name (ly:music-property m 'name)))
         (case name
          ((PropertySet) (set! tempo (ly:music-property m 'value)))
          ((KeyChangeEvent)
           (set! keys (put! keys (vector-ref state 0)
                            (ly:music-property m 'pitch-alist))))
          ((ContextChange)
           (if (eq? (ly:music-property m 'change-to-type) 'Staff)
               (let ((target
                      (find (lambda (entry)
                              (and (equal? (car entry) (ly:music-property m 'change-to-id))
                                   (equal? (drop-right (cdr entry) 1)
                                           (if (null? staff) '() (drop-right staff 1)))))
                            staff-paths)))
                 (if target (vector-set! state 0 (cdr target))))))
          ((EventChord)
           (let* ((events (ly:music-property m 'elements))
                  (spans (filter rectify:trill-event? events))
                  (notes (rectify:trill-notes m)))
             (if (pair? performance-tempos)
                 (begin
                   (set! (ly:music-property m 'trill-twiddle) (/ tempo 600))
                   (for-each
                    (lambda (event)
                      (if (and (eq? (ly:music-property event 'articulation-type) 'trill)
                               (not (number? (ly:music-property event 'twiddle))))
                          (set! (ly:music-property event 'twiddle) (/ tempo 600)))) events)))
             (if (pair? spans) (set! (ly:music-property m 'trill-boundary) #t))
             (for-each
              (lambda (e)
                (if (= (ly:music-property e 'span-direction) STOP)
                    (vector-set! state 1 #f))) spans)
             (for-each
              (lambda (e)
                (if (= (ly:music-property e 'span-direction) START)
                    (begin
                      (if (vector-ref state 1)
                          (rectify:trill-warning e "nested start in the same Voice"))
                      (vector-set! state 1 e)
                      (vector-set! state 2 #f)
                      (vector-set! state 3 #f)))) spans)
             (set! (ly:music-property m 'elements)
                   (filter (lambda (e) (not (rectify:trill-event? e))) events))
             (if (and (vector-ref state 1) (pair? notes)
                      (not (vector-ref record 5)))
                 (if (not (= (length notes) 1))
                     (rectify:trill-warning m "polyphonic chord")
                     (let* ((pitch (ly:music-property (car notes) 'pitch))
                            (start (vector-ref state 1))
                            (initial (not (vector-ref state 2)))
                            (aux
                             (if (and (not initial)
                                      (equal? pitch (vector-ref state 2)))
                                 (vector-ref state 3)
                                 (let ((explicit (ly:music-property start 'pitch)))
                                   (if (and initial (ly:pitch? explicit)) explicit
                                       (rectify:trill-upper
                                        pitch (key-at (vector-ref state 0))
                                        (and initial
                                             (ly:music-property start 'trill-alteration))))))))
                       (if initial
                           (begin (vector-set! state 2 pitch)
                                  (vector-set! state 3 aux)))
                       (set! (ly:music-property m 'elements)
                             (append
                              (filter (lambda (e)
                                        (not (eq? (ly:music-property e 'articulation-type)
                                                  'trill)))
                                      (ly:music-property m 'elements))
                              (list (make-music 'ArticulationEvent
                                                'articulation-type 'trill
                                                'trill-resolved #t
                                                'twiddle (/ tempo 600)
                                                'pitch aux))))))))))))
     (define (sort-records!)
       (define (priority record)
         (let* ((m (vector-ref record 4))
                (name (ly:music-property m 'name)))
           (cond
            ((memq name '(KeyChangeEvent PropertySet ContextChange)) 0)
            ((and (eq? name 'EventChord)
                  (null? (rectify:trill-notes m))) 1)
            (else 2))))
       (set! records
             (stable-sort (reverse records)
                          (lambda (a b)
                            (or (< (vector-ref a 0) (vector-ref b 0))
                                (and (= (vector-ref a 0) (vector-ref b 0))
                                     (< (priority a) (priority b))))))))
     (set! music (event-chord-wrap! (unfold-repeats-fully music)))
     (rectify:walk-voices music collect)
     (split-at-controls!)
     (sort-records!)
     (for-each resolve records)
     (set! music (music-map rectify:trill-merge-ties music))
     (set! records '())
     (rectify:walk-voices music collect)
     (sort-records!)
     (for-each mark-unsafe-ties records)
     (for-each (lambda (entry) (suppress-trill (cdr entry))) pending-ties)
     music))
